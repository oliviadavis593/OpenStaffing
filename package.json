{
  "name": "openstaffing",
  "private": true,
  "description": "Free, open-source data on how well hospitals staff their nurses, and who owns them.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@openstaffing/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @openstaffing/db generate",
    "db:migrate": "pnpm --filter @openstaffing/db migrate:dev",
    "db:seed": "pnpm --filter @openstaffing/db seed",
    "db:studio": "pnpm --filter @openstaffing/db studio",
    "ingest": "pnpm --filter @openstaffing/ingest cli"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
