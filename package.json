{
  "name": "openstaffing",
  "private": true,
  "description": "Free, open-source data on how well hospitals staff their nurses, and who owns them.",
  "license": "MIT",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@openstaffing/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "npm run generate -w @openstaffing/db",
    "db:migrate": "npm run migrate:dev -w @openstaffing/db --",
    "db:seed": "npm run seed -w @openstaffing/db",
    "db:studio": "npm run studio -w @openstaffing/db",
    "ingest": "npm run cli -w @openstaffing/ingest --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
