# Copy to .env at the repo root: cp .env.example .env
# Local Postgres from docker-compose (pnpm db:up)
DATABASE_URL="postgresql://openstaffing:openstaffing@localhost:5432/openstaffing?schema=public"

# Illinois Hospital Report Card API (public, no key needed)
IL_REPORT_CARD_BASE_URL="https://healthcarereportcard.illinois.gov"

# Polite request rate for public APIs (requests per second)
INGEST_RATE_LIMIT_RPS="2"

# Optional: secret used to trigger on-demand revalidation after ingest
REVALIDATE_SECRET="change-me"
